# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template, so keep every key here with a safe placeholder value.

# ---------------------------------------------------------------------------
# Worktree identity and host ports
# ---------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME MUST equal this checkout's directory name. It namespaces
# the stack's containers, network, and volumes, so a worktree running in parallel
# stays fully independent — and `scripts/docker_common.py`-style tooling filters
# `docker ps` by it.
COMPOSE_PROJECT_NAME=roguelike

# Every published port is `conventional_base + slot`, where this checkout's slot
# is 2. The registry that assigns slots is devkit's `ports.toml` — add a
# project there rather than picking a free-looking number by hand. Re-generate
# this block with: python <devkit>/scripts/devkit_ports.py roguelike

# The Vite dev server and its preview. BOTH ARE OPTIONAL, and a worktree should
# normally leave them unset: `src/worktreePort.ts` derives an offset from the
# checkout's own directory name, so a worktree serves on 4100+n / 5100+n with
# nothing configured, and the static checkout keeps 4100 / 5100.
#
# That is derived rather than assigned because two of the three ways a worktree
# is cut here (`claude --worktree`, and Remote Control spawning one) run no
# project code at the time, so nothing can seed a file for them. The module
# carries the whole reasoning.
#
# Set them to pin a port anyway — an explicit value always wins. The case that
# needs it is a hash collision between two worktrees, which `strictPort: true`
# reports as a startup error rather than hiding; give one of them a free number.
#
# These are NOT in devkit's `ports.toml`, and no longer want to be: that registry
# assigns published *container* ports for the ephemeral box tier, which this
# worktree tier deliberately has no part of.
#VITE_PORT=4100
#VITE_PREVIEW_PORT=5100

# ---------------------------------------------------------------------------
# Telemetry
# ---------------------------------------------------------------------------
# Resource attributes. `service.instance.id` is what distinguishes two worktrees
# exporting to the same collector — without it their metrics silently merge.
OTEL_SERVICE_NAME=roguelike
OTEL_RESOURCE_ATTRIBUTES=service.name=roguelike,service.instance.id=roguelike,deployment.environment=local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
