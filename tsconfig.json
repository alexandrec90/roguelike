{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // `vite.config.ts` imports `./src/worktreePort.ts` WITH the extension, because
    // Vite's coming native config loader resolves that file with Node rather than a
    // bundler and warns on an extensionless specifier. This permits the spelling; it
    // does not require it, so nothing under `src/` changes. Safe with `noEmit`.
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["src", "vite.config.ts"]
}
